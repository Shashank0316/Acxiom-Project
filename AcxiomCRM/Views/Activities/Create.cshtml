@model AcxiomCRM.Models.Activity
<h2>Log Activity</h2>
<form asp-action='Create'>
    <input type='hidden' name='CustomerId' value='@ViewBag.CustomerId' />
    <input type='hidden' name='LeadId' value='@ViewBag.LeadId' />
    <div class='form-group'><label>Type</label>
        <select asp-for='ActivityType' class='form-control'>
            <option value='Call'>Call</option><option value='Email'>Email</option><option value='Note'>Note</option>
        </select>
    </div>
    <div class='form-group'><label>Subject</label><input asp-for='Subject' class='form-control' /></div>
    <div class='form-group'><label>Description</label><textarea asp-for='Description' class='form-control'></textarea></div>
    <button type='submit' class='btn btn-primary mt-2'>Save</button>
</form>
