@model AcxiomCRM.Models.Lead
<h2>Create Lead</h2>
<form asp-action='Create'>
    <div class='form-group'><label>Name</label><input asp-for='LeadName' class='form-control' /></div>
    <div class='form-group'><label>Email</label><input asp-for='Email' class='form-control' /></div>
    <div class='form-group'><label>Expected Value</label><input asp-for='ExpectedValue' class='form-control' /></div>
    <button type='submit' class='btn btn-primary mt-2'>Save</button>
</form>
