@model AcxiomCRM.Models.Lead
<h2>Edit Lead</h2>
<form asp-action='Edit'>
    <input type='hidden' asp-for='LeadId' />
    <input type='hidden' asp-for='AssignedToId' />
    <div class='form-group'><label>Name</label><input asp-for='LeadName' class='form-control' /></div>
    <div class='form-group'><label>Status</label>
        <select asp-for='Status' class='form-control'>
            <option value='New'>New</option><option value='Contacted'>Contacted</option>
            <option value='Qualified'>Qualified</option><option value='Unqualified'>Unqualified</option>
        </select>
    </div>
    <button type='submit' class='btn btn-primary mt-2'>Save</button>
</form>
