@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Conversion Report";
}

<h1>Lead Conversion Report</h1>
<a href="@Url.Action("Index", "Reports")" class="btn btn-secondary mb-3">Back to Reports</a>

<table class="table table-striped table-bordered mt-3">
    <thead>
        <tr>
            <th>Lead Name</th>
            <th>Company</th>
            <th>Source</th>
            <th>Expected Value</th>
            <th>Status</th>
            <th>Created Date</th>
            <th>Assigned To</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td>@lead.LeadName</td>
                <td>@lead.CompanyName</td>
                <td>@lead.Source</td>
                <td>@lead.ExpectedValue.ToString("C")</td>
                <td>
                    @if (lead.Status == "Converted")
                    {
                        <span class="badge bg-success">Converted</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@lead.Status</span>
                    }
                </td>
                <td>@lead.CreatedDate.ToShortDateString()</td>
                <td>@(lead.AssignedTo?.Email ?? "-")</td>
            </tr>
        }
    </tbody>
</table>
